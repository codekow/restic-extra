[Unit]
Description=Rest Server
Documentation=https://github.com/restic/rest-server
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/default/rest-server

[Service]
WorkingDirectory=/storage/restic

User=backup
Group=backup
UMask=0007

EnvironmentFile=/etc/default/rest-server
ExecStartPre=/bin/bash -c "if [ -z \"${RESTIC_ADDR}\" ]; then echo \"Variable RESTIC_ADDR not set in /etc/default/rest-server\"; exit 1; fi"
ExecStartPre=/bin/bash -c "if [ -z \"${HTPASSWD}\" ]; then echo \"Variable HTPASSWD not set in /etc/default/rest-server\"; exit 1; fi"

ExecStart=/usr/bin/rclone serve restic \
           --addr ${RESTIC_ADDR} \
           --htpasswd ${HTPASSWD} \
           ${RESTIC_OPTS} \
           ./

# Let systemd restart this service always
Restart=always
RestartSec=5

# Specifies the maximum file descriptor number that can be opened by this process
LimitNOFILE=65536

# Disable timeout logic and wait until process is stopped
SendSIGKILL=no

[Install]
WantedBy=multi-user.target
